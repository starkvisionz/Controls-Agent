# Optional. When set, the Hermes agent panel streams answers from the Claude API.
# When unset, Hermes falls back to a fully local analyst that answers from the
# project-controls database — the app is fully functional either way.
ANTHROPIC_API_KEY=

# Optional model override for the agent panel.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Path to the SQLite database file (defaults to ./data/hermes.db).
HERMES_DB_PATH=
