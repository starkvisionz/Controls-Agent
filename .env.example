# --- Access control --------------------------------------------------------
# Starkvisionz holds a project's cost, schedule and commercial position. Set both of
# these before exposing it beyond localhost.
#
# Generate them with:  npm run auth:hash -- 'your password'
#
# STARKVISIONZ_AUTH_PASSWORD accepts either a scrypt digest (preferred) or a plain
# string. With neither variable set, Starkvisionz runs unauthenticated in development
# and REFUSES TO SERVE in production rather than exposing the registers.
STARKVISIONZ_AUTH_PASSWORD=
STARKVISIONZ_SESSION_SECRET=

# Number of reverse proxies between the internet and this app. Rate limiting
# keys on the client address, and X-Forwarded-For is caller-supplied: the header
# is believed ONLY when this says how many hops to trust, and then only the
# entry the innermost trusted proxy observed is used.
#
#   unset / 0  reached directly — no forwarding header is trusted, and all
#              callers share one bucket per scope
#   1          one reverse proxy (nginx, Caddy, Traefik) in front
#
# Setting this higher than the real hop count would let a caller forge the
# address the limiter keys on.
STARKVISIONZ_TRUSTED_PROXIES=

# --- Agent -----------------------------------------------------------------
# Optional. When set, the agent panel streams answers from the Claude API.
# When unset, Starkvisionz falls back to a local analyst that answers from the
# project-controls database — the app is fully functional either way.
ANTHROPIC_API_KEY=

# Optional model override for the agent panel.
ANTHROPIC_MODEL=claude-opus-5

# --- Storage ---------------------------------------------------------------
# Optional. Path to the SQLite database file (defaults to ./data/starkvisionz.db).
# Point this at a persistent volume on a deployed host.
STARKVISIONZ_DB_PATH=
