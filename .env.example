# --- Access control --------------------------------------------------------
# Hermes holds a project's cost, schedule and commercial position. Set both of
# these before exposing it beyond localhost.
#
# Generate them with:  npm run auth:hash -- 'your password'
#
# HERMES_AUTH_PASSWORD accepts either a scrypt digest (preferred) or a plain
# string. With neither variable set, Hermes runs unauthenticated in development
# and REFUSES TO SERVE in production rather than exposing the registers.
HERMES_AUTH_PASSWORD=
HERMES_SESSION_SECRET=

# --- Agent -----------------------------------------------------------------
# Optional. When set, the agent panel streams answers from the Claude API.
# When unset, Hermes falls back to a local analyst that answers from the
# project-controls database — the app is fully functional either way.
ANTHROPIC_API_KEY=

# Optional model override for the agent panel.
ANTHROPIC_MODEL=claude-opus-5

# --- Storage ---------------------------------------------------------------
# Optional. Path to the SQLite database file (defaults to ./data/hermes.db).
# Point this at a persistent volume on a deployed host.
HERMES_DB_PATH=
